---
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Elisa Sabor & Arte</title>
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
  </head>
  <body class="min-h-screen bg-cream-2/60">
    <slot />
  </body>
</html>

<style is:global>
  .campo { display: grid; gap: .35rem; margin-bottom: 1rem; }
  .campo label { font-size: .875rem; font-weight: 600; color: var(--color-cocoa); }
  .campo small { font-size: .78rem; color: var(--color-mocha); }
  .entrada { width: 100%; border-radius: .9rem; border: 1px solid rgb(43 26 18 / .18); background: #fff; padding: .75rem 1rem; font-size: 16px; color: var(--color-choco); }
  .entrada:focus { outline: none; border-color: var(--color-terra); box-shadow: 0 0 0 3px rgb(183 100 60 / .18); }
  .alerta { border-radius: .9rem; padding: .75rem 1rem; font-size: .9rem; margin-bottom: 1rem; }
  .alerta.error { background: #fbe5de; color: #9a3412; }
  .alerta.ok { background: #e3f6ea; color: #166534; }
  .alerta.info { background: var(--color-cream-2); color: var(--color-cocoa); }
  .tarjeta { background: #fff; border-radius: 1.5rem; padding: 1.5rem; box-shadow: var(--shadow-soft); margin-bottom: 1.25rem; }
  .tarjeta h2 { font-size: 1.25rem; font-weight: 600; display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-bottom: .35rem; }
  .estado { font-family: var(--font-sans); font-size: .75rem; font-weight: 700; padding: .2rem .65rem; border-radius: 999px; }
  .estado.on { background: #e3f6ea; color: #166534; }
  .estado.off { background: var(--color-cream-2); color: var(--color-mocha); }
  .sw { position: relative; width: 50px; height: 28px; flex: none; }
  .sw input { opacity: 0; position: absolute; inset: 0; margin: 0; cursor: pointer; z-index: 1; }
  .sw span { position: absolute; inset: 0; background: #d8cbb8; border-radius: 999px; transition: background .2s; }
  .sw span::after { content: ''; position: absolute; width: 22px; height: 22px; border-radius: 50%; background: #fff; top: 3px; left: 3px; transition: transform .2s; }
  .sw input:checked + span { background: var(--color-terra); }
  .sw input:checked + span::after { transform: translateX(22px); }
  .sw input:focus-visible + span { outline: 2px solid var(--color-choco); outline-offset: 2px; }
  code { background: var(--color-cream-2); padding: 1px 6px; border-radius: 6px; font-size: .85em; }
</style>
