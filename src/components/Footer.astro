---
import { site, nav, wa } from '../data/site';
import Icons from './Icons.astro';
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-choco text-cream/80">
  <div class="container-x py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="flex items-center gap-3">
          <img src="/img/logo.webp" alt="" width="52" height="52" class="h-13 w-13 rounded-xl" />
          <div>
            <p class="font-display text-xl font-semibold text-cream">Elisa <span class="text-gold">Sabor &amp; Arte</span></p>
            <p class="text-xs uppercase tracking-[0.2em] text-cream/60">{site.tagline}</p>
          </div>
        </div>
        <p class="mt-5 max-w-sm text-sm leading-relaxed text-cream/70">{site.description}</p>
        <div class="mt-5 flex gap-2">
          <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" class="rounded-full border border-cream/15 p-2.5 transition hover:border-gold hover:text-gold"><Icons name="ig" /></a>
          <a href={site.social.tiktok} target="_blank" rel="noopener" aria-label="TikTok" class="rounded-full border border-cream/15 p-2.5 transition hover:border-gold hover:text-gold"><Icons name="tt" /></a>
          <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" class="rounded-full border border-cream/15 p-2.5 transition hover:border-gold hover:text-gold"><Icons name="fb" /></a>
        </div>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Explora</p>
        <ul class="mt-4 space-y-2 text-sm">
          {nav.map((n) => <li><a href={n.href} class="transition hover:text-cream">{n.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">Pedidos</p>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href={wa()} target="_blank" rel="noopener" class="inline-flex items-center gap-2 transition hover:text-cream"><Icons name="wa" class="h-4 w-4 text-wa" /> {site.phone}</a></li>
          <li><a href={site.social.instagram} target="_blank" rel="noopener" class="inline-flex items-center gap-2 transition hover:text-cream"><Icons name="ig" class="h-4 w-4" /> @{site.handle}</a></li>
          <li class="text-cream/60">Perú · Pedidos con anticipación</li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col items-start justify-between gap-3 border-t border-cream/10 pt-6 text-xs text-cream/50 sm:flex-row sm:items-center">
      <p>© {year} {site.name}. Todos los derechos reservados.</p>
      <p class="font-display italic text-cream/60">{site.claim}</p>
    </div>
  </div>
</footer>
