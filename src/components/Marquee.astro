---
const items = ['Panadería', 'Pastelería', 'Tortas personalizadas', 'Bocaditos dulces y salados', 'Pies y tartas', 'Postres', 'Un sabor para todos'];
const row = [...items, ...items];
---
<div class="mt-14 border-y border-choco/10 bg-cream-2/60 py-4" aria-hidden="true">
  <div class="flex overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
    <div class="flex shrink-0 animate-marquee items-center gap-8 pr-8">
      {row.map((t) => (
        <span class="flex items-center gap-8 whitespace-nowrap font-display text-lg italic text-cocoa">
          {t} <span class="h-1.5 w-1.5 rounded-full bg-terra"></span>
        </span>
      ))}
    </div>
  </div>
</div>
