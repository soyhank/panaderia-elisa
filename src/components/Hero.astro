---
import { site, wa } from '../data/site';
import Icons from './Icons.astro';
---
<section id="top" class="relative overflow-hidden pt-28 sm:pt-32 lg:pt-36">
  <!-- blobs decorativos -->
  <div aria-hidden="true" class="pointer-events-none absolute -left-24 -top-24 h-72 w-72 rounded-full bg-terra/15 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-20 top-40 h-80 w-80 rounded-full bg-gold/20 blur-3xl"></div>

  <div class="container-x">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-8">
      <div class="reveal in">
        <p class="eyebrow">Panadería · Pastelería artesanal</p>
        <h1 class="mt-5 text-[2.75rem] font-medium leading-[1.02] tracking-tight sm:text-6xl lg:text-[4.6rem]">
          El arte de <em class="font-light italic text-terra">endulzar</em><br />tu vida.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-cocoa">
          Panes, postres, bocaditos dulces y salados y tortas personalizadas al gusto de nuestros clientes.
          Sabor auténtico hecho en casa y máxima frescura garantizada.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={wa()} target="_blank" rel="noopener" class="btn-wa"><Icons name="wa" class="h-4 w-4" /> Pedir por WhatsApp</a>
          <a href="#carta" class="btn-outline">Ver la carta <Icons name="arrow" class="h-4 w-4" /></a>
        </div>
        <dl class="mt-10 grid max-w-md grid-cols-3 gap-4 border-t border-choco/10 pt-6">
          <div><dt class="text-xs uppercase tracking-widest text-mocha">Desde</dt><dd class="mt-1 font-display text-2xl font-semibold">S/ 10.50</dd></div>
          <div><dt class="text-xs uppercase tracking-widest text-mocha">Variedades</dt><dd class="mt-1 font-display text-2xl font-semibold">+30</dd></div>
          <div><dt class="text-xs uppercase tracking-widest text-mocha">Tortas</dt><dd class="mt-1 font-display text-2xl font-semibold">A tu gusto</dd></div>
        </dl>
      </div>

      <div class="relative mx-auto w-full max-w-md lg:max-w-none reveal in">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2rem] shadow-lift">
          <img src="/img/hero.webp" alt="Torta corazón personalizada de Elisa Sabor & Arte, decorada con crema en tonos rosa y blanco" width="960" height="1200" fetchpriority="high" class="h-full w-full object-cover" />
        </div>
        <!-- tarjeta flotante 1 -->
        <div class="absolute -left-4 bottom-10 hidden w-44 rotate-[-4deg] overflow-hidden rounded-2xl bg-cream shadow-lift ring-1 ring-choco/10 sm:block lg:-left-10">
          <img src="/img/tartaleta-fresas.webp" alt="" width="640" height="640" loading="lazy" class="aspect-square w-full object-cover" />
          <p class="px-3 py-2 text-xs font-semibold">Tartaleta de fresas <span class="text-terra">S/ 12</span></p>
        </div>
        <!-- tarjeta flotante 2 -->
        <div class="absolute -right-3 top-8 hidden rotate-[5deg] items-center gap-2 rounded-2xl bg-cream px-4 py-3 shadow-lift ring-1 ring-choco/10 sm:flex lg:-right-8">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-terra/10 text-terra"><Icons name="heart" class="h-5 w-5" /></span>
          <span class="text-sm font-semibold leading-tight">Hecho en casa<br /><span class="font-normal text-mocha">con dedicación</span></span>
        </div>
      </div>
    </div>
  </div>
</section>
