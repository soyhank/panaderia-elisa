---
import { wa } from '../data/site';
import Icons from './Icons.astro';
---
<a href={wa()} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"
   class="fixed bottom-5 right-5 z-40 flex items-center gap-2 rounded-full bg-wa p-3.5 text-white shadow-lift transition hover:scale-105 sm:pr-5">
  <span class="absolute inset-0 -z-10 animate-ping rounded-full bg-wa/50 [animation-duration:2.4s] motion-reduce:hidden"></span>
  <Icons name="wa" class="h-6 w-6" />
  <span class="hidden text-sm font-semibold sm:inline">Pedir ahora</span>
</a>
