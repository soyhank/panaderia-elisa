---
import Icons from './Icons.astro';
const points = [
  { icon: 'chef', title: 'Hecho en casa', text: 'Recetas propias, elaboradas con dedicación en cada horneada.' },
  { icon: 'heart', title: 'A tu gusto', text: 'Tortas y bocaditos personalizados según tu antojo o celebración.' },
  { icon: 'clock', title: 'Siempre fresco', text: 'Preparamos tu pedido para la fecha que lo necesitas.' },
] as const;
---
<section id="nosotros" class="scroll-mt-24 py-16 sm:py-24">
  <div class="container-x">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="relative reveal">
        <div class="overflow-hidden rounded-[2rem] shadow-lift">
          <img src="/img/vitrina.webp" alt="Vitrina de pastelería con tortas, tartas y postres" width="626" height="469" loading="lazy" class="aspect-[4/3] w-full object-cover" />
        </div>
        <div class="absolute -bottom-6 -right-2 w-40 rotate-[4deg] overflow-hidden rounded-2xl shadow-lift ring-4 ring-cream sm:-right-6 sm:w-48">
          <img src="/img/bocaditos.webp" alt="Bocaditos dulces personalizados en tonos rosados" width="556" height="556" loading="lazy" class="aspect-square w-full object-cover" />
        </div>
        <span class="absolute -left-4 -top-4 rounded-full bg-gold px-4 py-2 font-display text-sm italic text-choco shadow-soft sm:-left-6">Un sabor para todos</span>
      </div>

      <div class="reveal">
        <p class="eyebrow">El emprendimiento</p>
        <h2 class="mt-4 text-4xl font-medium leading-tight tracking-tight sm:text-5xl">
          Sabor auténtico,<br /><em class="font-light italic text-terra">hecho con cariño.</em>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-cocoa">
          Elaboramos variedades de panes, postres, bocaditos dulces y salados y tortas personalizadas
          al gusto, antojo y pedidos que realicen nuestros clientes. Cada producto sale de nuestra cocina
          pensando en satisfacer a quien lo disfruta.
        </p>
        <ul class="mt-8 grid gap-4 sm:grid-cols-3">
          {points.map((p) => (
            <li class="rounded-2xl border border-choco/10 bg-white/50 p-4">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-terra/10 text-terra"><Icons name={p.icon} class="h-5 w-5" /></span>
              <p class="mt-3 font-semibold">{p.title}</p>
              <p class="mt-1 text-sm leading-relaxed text-mocha">{p.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
